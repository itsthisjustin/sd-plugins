{
  "title": "BookFusion",
  "token": {
    "file": "/.crosspoint/bookfusion.json",
    "path": "token"
  },
  "browse": {
    "url": "https://www.bookfusion.com/api/user/books/search",
    "method": "POST",
    "headers": {
      "Authorization": "Bearer {token}",
      "Accept": "application/json; api_version=10",
      "Content-Type": "application/json"
    },
    "body": "{\"page\":{page},\"per_page\":{limit},\"sort\":\"added_at-desc\"}",
    "items": "",
    "fields": {
      "title": "title",
      "author": "authors.0.name",
      "id": "id"
    },
    "page_size": 8
  },
  "download": {
    "url": "https://www.bookfusion.com/api/user/books/{id}/download",
    "method": "POST",
    "headers": {
      "Authorization": "Bearer {token}",
      "Accept": "application/json; api_version=10",
      "Content-Type": "application/json"
    },
    "body": "{}",
    "url_path": "url",
    "dest_dir": "/BookFusion",
    "filename": "{title}.epub",
    "sidecar": {
      "path": "/.crosspoint/bookfusion_{md5}.json",
      "body": "{\"book_id\":{id}}"
    }
  },
  "auth": {
    "request": {
      "url": "https://www.bookfusion.com/api/user/auth/device",
      "method": "POST",
      "headers": {
        "Accept": "application/json; api_version=10",
        "Content-Type": "application/json"
      },
      "body": "{\"client_id\":\"koreader\"}"
    },
    "poll": {
      "url": "https://www.bookfusion.com/api/user/auth/token",
      "method": "POST",
      "headers": {
        "Accept": "application/json; api_version=10",
        "Content-Type": "application/json"
      },
      "body": "{\"grant_type\":\"urn:ietf:params:oauth:grant-type:device_code\",\"client_id\":\"koreader\",\"device_code\":\"{device_code}\"}"
    }
  }
}